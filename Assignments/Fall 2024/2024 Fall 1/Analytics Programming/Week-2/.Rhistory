#Write a function that will display the question below and return the correct answer.
#a. Was Joanne able to complete more tasks when she drank coffee or days when she did not drink coffee?
# Define the function to compare tasks completed with and without coffee
compareTasksWithAndWithoutCoffee <- function(data) {
# Access the relevant columns
tasksWithoutCoffee <- data$TasksWithoutCoffee
tasksWithCoffee <- data$TasksWithCoffee
# Calculate the mean of tasks completed without coffee
meanWithoutCoffee <- mean(tasksWithoutCoffee, na.rm = TRUE)
# Calculate the mean of tasks completed with coffee
meanWithCoffee <- mean(tasksWithCoffee, na.rm = TRUE)
# Compare the means and generate a result message
if (meanWithCoffee > meanWithoutCoffee) {
result <- "Joanne was able to complete more tasks on days when she drank coffee."
} else if (meanWithCoffee < meanWithoutCoffee) {
result <- "Joanne was able to complete more tasks on days when she did not drink coffee."
} else {
result <- "Joanne completed the same number of tasks on days with and without coffee."
}
# Print the result message
print(result)
# Return the result
return(result)
}
# Example usage:
# Assuming joanneTasks is your data frame
compareTasksWithAndWithoutCoffee(joanneTasks)
#Write a function that will display the question below and return the correct answer.
#a. Was Joanne able to complete more tasks when she drank coffee or days when she did not drink coffee?
compare_tasks <- function(task){
if(is.data.frame(task)){
if(task$Number.of.Tasks.With.Coffee && task$Number.of.Tasks.Without.Coffee){
total_task_with_coffee <- sum(task$Number.of.Tasks.With.Coffee, na.rm = TRUE)
total_task_without_coffee <- sum(task$Number.of.Tasks.Without.Coffee, na.rm = TRUE)
if(total_task_without_coffee > total_task_with_coffee){
return("Joanne was able to complete more task without coffee than by drinking coffee.")
} else if(total_task_without_coffee < total_task_with_coffee){
return("Joanne was able to complete less task without coffee than by drinking coffee.")
} else {
return("Joanne was able to complete same number of task with or without coffee.")
}
}
else{
return("Please provide the data.")
}
}
}
result <- compare_tasks(joanneTasks)
