# 2 Solution:
mean_pregnancy <- 265
sd_pregnancy <- 15
# a. Middle 50% (Q1 and Q3)
Q1 <- mean_pregnancy + qnorm(0.25) * sd_pregnancy
Q3 <- mean_pregnancy + qnorm(0.75) * sd_pregnancy
q1 <- qnorm(0.25, mean = mean_pregnancy, sd = sd_pregnancy)
q3 <- qnorm(0.75, mean = mean_pregnancy, sd = sd_pregnancy)
c(q1, q3)
cat("Middle 50% range of pregnancies: (", Q1, ", ", Q3, ")\n", sep="")
# b. Proportion of pregnancies > 275 days
z_score_275 <- (275 - mean_pregnancy) / sd_pregnancy
p_greater_275 <- 1 - pnorm(z_score_275)
cat("Proportion of pregnancies more than 275 days:", p_greater_275, "\n")
