# Given data
mean_mileage <- 34
sd_mileage <- 5
# a. Probability mileage > 33 mpg
z_score_33 <- (33 - mean_mileage) / sd_mileage
p_greater_33 <- 1 - pnorm(z_score_33)
cat("Probability that mileage is greater than 33 mpg:", p_greater_33, "\n")
# b. Probability mileage between 33 mpg and 35 mpg
z_score_35 <- (35 - mean_mileage) / sd_mileage
p_between_33_and_35 <- pnorm(z_score_35) - pnorm(z_score_33)
cat("Probability that mileage is between 33 mpg and 35 mpg:", p_between_33_and_35, "\n")
